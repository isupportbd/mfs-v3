# Lock files — regenerated per developer's package manager
# package-lock.json is committed: Docker builds use `npm ci` and Coolify does
# not have a lockfile otherwise, which makes npm's resolver crash with
# "Cannot read properties of null (reading 'edgesOut')".
bun.lock
pnpm-lock.yaml
yarn.lock
